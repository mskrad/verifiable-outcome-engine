# Public replay defaults
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
PROGRAM_ID=6QtLot4uztCfjUuPreoiYPc3e1gH2fg6pq8hKYyvCP6B

# Optional
PORT=8787
ARTIFACT_PATH=
TS_NODE_BIN=
LIVE_RAFFLE_PROGRAM_ID=6QtLot4uztCfjUuPreoiYPc3e1gH2fg6pq8hKYyvCP6B

# Security controls
VRE_ALLOW_REPLAY_OVERRIDES=0
VRE_ALLOWED_RPC_URLS=
TRUST_PROXY=0
JSON_BODY_LIMIT_BYTES=16384
REPLAY_TIMEOUT_MS=30000

# Public /examples page — keyless demo draws.
# Must match a draw_enabled entry in config/partners.json (its own key, not a real partner's).
EXAMPLES_DEMO_API_KEY=
EXAMPLES_DRAW_RATE_LIMIT_MS=15000

# Operator keypair for live draws.
# Must be the ProgramConfig admin of the target program: review_compiled_artifact is
# admin-gated and allow_unreviewed_binding is false, so any other wallet fails the draw
# with "ProgramConfig admin mismatch". Sortition routes do not need it.
LIVE_RAFFLE_WALLET=

# Optional World ID v4 live-raffle gate
WORLD_VERIFY_URL=https://developer.world.org/api/v4/verify
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION_ID=vre-raffle-entry
WORLD_ENVIRONMENT=staging

