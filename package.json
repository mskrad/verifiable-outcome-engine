{
  "name": "verifiable-outcome-sdk",
  "version": "0.7.0",
  "description": "On-chain proof of who won. Commit rules before the draw, anyone verifies from a transaction signature.",
  "license": "MIT",
  "keywords": [
    "solana",
    "verifiable",
    "outcome",
    "raffle",
    "airdrop",
    "competition",
    "proof",
    "sdk"
  ],
  "homepage": "https://verifiableoutcome.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mskrad/verifiable-outcome-engine.git"
  },
  "type": "module",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sdk/index.js",
      "types": "./dist/sdk/index.d.ts"
    }
  },
  "files": [
    "dist/sdk/index.js",
    "dist/sdk/index.d.ts",
    "dist/sdk/verify.js",
    "dist/sdk/verify.d.ts",
    "dist/sdk/artifact.js",
    "dist/sdk/artifact.d.ts",
    "dist/sdk/composite_rank_desc.js",
    "dist/sdk/composite_rank_desc.d.ts",
    "dist/sdk/snapshot.js",
    "dist/sdk/snapshot.d.ts",
    "dist/sdk/idl.js",
    "dist/sdk/idl.d.ts",
    "dist/sdk/types.js",
    "dist/sdk/types.d.ts",
    "dist/sdk/internals.js",
    "dist/sdk/internals.d.ts",
    "dist/sdk/sortition.js",
    "dist/sdk/sortition.d.ts",
    "dist/sdk/conditions.js",
    "dist/sdk/conditions.d.ts",
    "artifacts/outcome_idl.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/sdk/cli.js",
    "prepack": "yarn build",
    "build:artifact": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm scripts/build_artifact.ts",
    "replay": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm scripts/replay_verify.ts",
    "resolve:operator": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm scripts/resolve_operator.ts",
    "web": "node web/server.mjs"
  },
  "dependencies": {
    "@irys/upload": "^0.0.14",
    "@irys/upload-solana": "^0.1.8",
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4",
    "@worldcoin/idkit-core": "^4.1.3"
  },
  "devDependencies": {
    "@noble/hashes": "^1.3.1",
    "@types/node": "^24.6.0",
    "bn.js": "^5.2.3",
    "playwright": "^1.59.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
