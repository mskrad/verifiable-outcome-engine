pragma circom 2.0.0;
include "wesolowski_verify.circom";
include "hash_to_l.circom";
include "small_modexp.circom";
include "prod_n.circom";
include "../node_modules/circomlib/circuits/sha256/sha256.circom";
include "../node_modules/circomlib/circuits/bitify.circom";

// PHASE3 step 3: production A' sound circuit with N BAKED as a circuit constant
// (PROD_N(), generated by bake_n.js). N is no longer a witness input — the prover
// cannot choose the modulus. Otherwise identical to wesolowski_sound.
//   public  : commit, nonce
//   private : u[32], y[32], pi[32]
template WesolowskiSoundProd(EXPBITS_L, EXPBITS_T, T) {
    signal input commit;
    signal input nonce;
    signal input u[32];
    signal input y[32];
    signal input pi[32];

    var Nc[32] = PROD_N();

    // 1. commit binding: commit == field(SHA256(u||y)), low 253 bits.
    component ub[32];
    component yb[32];
    component sha = Sha256(4096);
    var idx = 0;
    for (var i = 0; i < 32; i++) { ub[i] = Num2Bits(64); ub[i].in <== u[i]; for (var b = 0; b < 64; b++) { sha.in[idx] <== ub[i].out[63 - b]; idx++; } }
    for (var i = 0; i < 32; i++) { yb[i] = Num2Bits(64); yb[i].in <== y[i]; for (var b = 0; b < 64; b++) { sha.in[idx] <== yb[i].out[63 - b]; idx++; } }
    component cc = Bits2Num(253);
    for (var i = 0; i < 253; i++) { cc.in[i] <== sha.out[255 - i]; }
    commit === cc.out;

    // 2. l = HashToL(commit, nonce).
    component h = HashToL();
    h.commit <== commit;
    h.nonce <== nonce;
    signal lf;
    lf <== h.l2[0] + h.l2[1] * 18446744073709551616;

    // 3. r = 2^T mod l.
    component me = ModExpK(EXPBITS_T, 2);
    me.base[0] <== 2; me.base[1] <== 0;
    me.exp <== T;
    me.modulus[0] <== h.l2[0];
    me.modulus[1] <== h.l2[1];
    signal rf;
    rf <== me.out[0] + me.out[1] * 18446744073709551616;

    // 4. Wesolowski: pi^l * u^r == y mod N (N = baked constant).
    component wv = WesolowskiVerify(EXPBITS_L);
    for (var i = 0; i < 32; i++) {
        wv.u[i] <== u[i];
        wv.y[i] <== y[i];
        wv.pi[i] <== pi[i];
        wv.N[i] <== Nc[i];
    }
    wv.l <== lf;
    wv.r <== rf;
}
component main {public [commit, nonce]} = WesolowskiSoundProd(128, 40, 1000);
